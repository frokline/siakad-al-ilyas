# Salin file ini menjadi .env lalu isi nilai sebenarnya.
# .env sudah masuk .gitignore sehingga tidak akan ter-commit.
#
# Setelah selesai, jalankan: php artisan siakad:periksa-produksi

APP_NAME="Siakad Ilyas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://siakad.ilyasinstitute.ac.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siakad_ilyas
DB_USERNAME=siakad
DB_PASSWORD=GANTI_DENGAN_PASSWORD_YANG_KUAT

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Kosongkan untuk mode otomatis: flag Secure hanya dipasang ketika HTTPS.
# Isi false hanya bila produksi memang berjalan tanpa HTTPS.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.ilyasinstitute.ac.id
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ilyasinstitute.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

SIAKAD_TIMEZONE=Asia/Makassar

# Berkas mahasiswa/dosen disimpan pada disk privat, bukan di public/.
BERKAS_DISK=berkas_local
# Isi clamscan bila antivirus tersedia di server, mis. /usr/bin/clamscan
BERKAS_SCANNER=none
BERKAS_KUOTA_BYTE=1073741824

SPP_TUJUAN_TRANSFER="Pembayaran diverifikasi manual oleh Admin Keuangan. Unggah foto bukti transfer pada halaman ini."
